QWidget#panel, QWidget#body, QScrollArea { background: #f0f3f5; }
QFrame#header { background: #192e39; }
QLabel { color: #203541; background: transparent; }
QLabel#title { color: #ffffff; }
QFrame#stateDot { background: #97acb6; border-radius: 4px; }
QFrame#stateDot[tone="attention"] { background: #ffd28b; }
QFrame#stateDot[tone="ready"] { background: #b9d9e3; }
QFrame#stateDot[tone="preview"] { background: #85c6f2; }
QFrame#stateDot[tone="active"] { background: #86e3bf; }
QFrame#stateDot[tone="real"] { background: #ffbb81; }
QFrame#section {
    background: #ffffff;
    border: 1px solid #d2dce0;
    border-radius: 9px;
}
QFrame#footer { background: #ffffff; border-top: 1px solid #d2dce0; }
QLabel[role="muted"], QLabel[role="column"] { color: #506672; }
QLabel#message {
    color: #643f11; background: #fff4df;
    border-left: 3px solid #c68629; padding: 6px 9px;
}
QFrame#rule { background: #dce4e7; border: none; }
QPushButton {
    background: #ffffff; color: #263e4c; border: 1px solid #b4c3cb;
    border-radius: 5px; padding: 4px 10px;
}
QPushButton:hover { background: #eef4f6; }
QPushButton:pressed { background: #dce7eb; }
QPushButton[role="mode"] {
    color: #e7eff2; background: #263f4b; border: 1px solid #526c78;
    padding: 6px;
}
QPushButton[role="mode"]:hover { background: #355463; }
QPushButton#dry:checked { color: #ffffff; background: #376486; border-color: #83b3d1; }
QPushButton#sim:checked { color: #113f37; background: #a5e1cd; border-color: #a5e1cd; }
QPushButton#real:checked { color: #562a0a; background: #ffca98; border-color: #ffca98; }
QPushButton#apply { background: #17665e; color: #ffffff; border-color: #17665e; }
QPushButton#apply:hover { background: #11564f; }
QPushButton:disabled, QPushButton#apply:disabled {
    color: #6b7c85; background: #e8edef; border-color: #d6e0e3;
}
QPushButton:focus, QComboBox:focus { border-color: #267dba; }
/* Keep the native spin buttons and their Retina arrows. */
QDoubleSpinBox {
    color: #203541; background-color: #f8fafb;
    selection-color: #ffffff; selection-background-color: #256a79;
}
QComboBox {
    color: #203541; background: #f8fafb; border: 1px solid #b9c9d0;
    border-radius: 4px; padding: 3px 5px;
    selection-color: #ffffff; selection-background-color: #256a79;
}
QDoubleSpinBox:disabled, QComboBox:disabled { color: #6b7c85; background: #edf2f3; }
QComboBox QAbstractItemView {
    color: #203541; background-color: #ffffff;
    selection-color: #ffffff; selection-background-color: #245a64;
}
QSlider::groove:horizontal { height: 4px; background: #dae3e6; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #327f75; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #17665e; width: 14px; margin: -5px 0; border-radius: 7px;
}
